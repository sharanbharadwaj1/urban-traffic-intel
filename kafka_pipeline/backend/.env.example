APP_NAME=Traffic Video Analytics Service
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./data/video_analytics.db
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_JOB_TOPIC=video_jobs
KAFKA_JOB_GROUP_ID=video_job_workers

STORAGE_BACKEND=local
STORAGE_BUCKET=traffic-video-analytics
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
LOCAL_STORAGE_PATH=./data/storage
UPLOAD_TEMP_PATH=./data/uploads

MODEL_PATH=yolov8n.pt
CONFIDENCE_THRESHOLD=0.35
FRAME_SKIP=5
FRAME_RESIZE_WIDTH=960
STATIONARY_FRAME_WINDOW=12
STATIONARY_PIXEL_THRESHOLD=18
TRACKER_MAX_DISTANCE=80
MAX_PARALLEL_JOBS=2
ALERT_CLASSES=car,bus,truck,motorcycle,person
CLASS_FILTER=car,bus,truck,motorcycle,person
SAVE_EVENT_SNAPSHOTS=true
PLATE_ENABLED=false
PLATE_CONFIRMATION_READS=1
PLATE_MIN_LENGTH=7
PLATE_MAX_LENGTH=11
PLATE_TRACK_BUFFER_SIZE=6
PLATE_TRACK_PROCESS_TOP_K=1
PLATE_TRACK_MAX_ATTEMPTS=12
PLATE_TRACK_TTL_FRAMES=90
PLATE_RETRY_COOLDOWN_FRAMES=20
ANPR_API_URL=https://api.platerecognizer.com/v1/plate-reader/
ANPR_API_TOKEN=
ANPR_COUNTRY=in
ANPR_MIN_SCORE=0.5
ANPR_TIMEOUT_SECONDS=15
ANPR_MIN_INTERVAL_SECONDS=2.0
ANPR_RETRY_BACKOFF_SECONDS=5.0
GRAPH_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
